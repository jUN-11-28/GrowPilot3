# Supabase — Project Settings › API Keys
# 새 publishable key(sb_publishable_...)를 사용한다. legacy anon JWT가 아니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google AI Studio — 서버에서만 사용, 브라우저에 노출되지 않는다
GEMINI_API_KEY=...
# 선택: 모델 이름이 바뀌었을 때만 지정한다 (기본값 gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# "gemini"(기본) 또는 "mock" — mock이면 AI 호출 없이 UI를 개발할 수 있다
AI_PROVIDER=gemini

# 선택: "1"(기본, 운영 경로) 또는 "2"(v2 진단 파이프라인 — 로컬 개발/테스트용).
# 0004·0005 마이그레이션을 적용한 DB가 있어야 한다. 자세한 내용은 README의 "v2" 절 참고.
# DIAGNOSIS_SCHEMA_VERSION=2
